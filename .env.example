# ==============================================================================
# ROGVEDA Root Environment Configuration Reference
# ==============================================================================

# Backend settings
HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Security & Authentication (replace with strong generated key)
JWT_SECRET_KEY=your-secure-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Local AI / LLM Server (e.g. LM Studio or Ollama OpenAI-compatible endpoint)
LLM_ENDPOINT=http://127.0.0.1:1234/v1

# Frontend API URL
VITE_API_BASE_URL=http://127.0.0.1:8000
