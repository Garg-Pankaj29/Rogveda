# ==============================================================================
# ROGVEDA Backend Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# NEVER commit the actual .env file with real secrets to version control.
# ==============================================================================

# Server settings
HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Security & Authentication (Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=your-secure-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Local AI / LLM Server (e.g. LM Studio or Ollama OpenAI-compatible endpoint)
LLM_ENDPOINT=http://127.0.0.1:1234/v1
